NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHAVE_ANONIMA
NEXT_PUBLIC_APP_URL=https://zelcon.vercel.app
SUPABASE_SERVICE_ROLE_KEY=CHAVE_SERVICE_ROLE

# Use pelo menos 32 caracteres aleatórios.
PORTAL_SESSION_SECRET=SEGREDO_ALEATORIO_LONGO

# Gere o par com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=CHAVE_PUBLICA_VAPID
VAPID_PRIVATE_KEY=CHAVE_PRIVADA_VAPID
VAPID_SUBJECT=mailto:contato@zelcon.com.br

# Sandbox: https://api-sandbox.asaas.com/v3
# Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=CHAVE_DA_API_ASAAS

# Token configurado no webhook do Asaas (header asaas-access-token).
ASAAS_WEBHOOK_SECRET=TOKEN_ALEATORIO_DO_WEBHOOK
